  router:{name:"Router Wi-Fi de alto rendimiento",category:"Redes",price:2199,description:"Conecta más dispositivos y mejora la cobertura de tu red."},
  kit:{name:"Kit de automatización",category:"Automatización",price:3499,description:"Una selección de dispositivos para comenzar tu proyecto inteligente."},
  business:{name:"Kit de videovigilancia empresarial",category:"Negocios",price:12999,description:"Solución de referencia para explorar la supervisión de instalaciones comerciales."}
};
const $=selector=>document.querySelector(selector);
const money=value=>new Intl.NumberFormat("es-MX",{style:"currency",currency:"MXN",maximumFractionDigits:0}).format(value);
const cart=new Map();
let selectedProduct=null,previousFocus=null,noticeTimer,bookingDraft=null,sdkReady=false;
function notice(message){const element=$("#notice");element.textContent=message;element.hidden=false;clearTimeout(noticeTimer);noticeTimer=setTimeout(()=>element.hidden=true,3500)}
function filterProducts(){
  const query=$("#search-input").value.trim().toLocaleLowerCase("es-MX"),category=$("#category-filter").value,maximum=Number($("#price-filter").value),sort=$("#sort-filter").value;
  $("#price-value").textContent=money(maximum);
  document.querySelectorAll("[data-category]").forEach(button=>button.setAttribute("aria-pressed",String(button.dataset.category===category)));
  const cards=[...document.querySelectorAll("[data-product]")];
  cards.sort((a,b)=>{const x=products[a.dataset.product],y=products[b.dataset.product];return sort==="low"?x.price-y.price:sort==="high"?y.price-x.price:sort==="name"?x.name.localeCompare(y.name,"es"):0});
  let visible=0;
  cards.forEach(card=>{const product=products[card.dataset.product];const show=(category==="all"||product.category===category)&&product.price<=maximum&&`${product.name} ${product.category} ${product.description}`.toLocaleLowerCase("es-MX").includes(query);card.hidden=!show;if(show)visible++;$("#product-grid").append(card)});
  $("#results-count").textContent=`${visible} ${visible===1?"producto":"productos"}`;
  $("#empty-results").classList.toggle("hidden",visible!==0);
}
function subtotal(){return [...cart].reduce((sum,[id,quantity])=>sum+products[id].price*quantity,0)}
function renderCart(){
  const area=$("#cart-items");let count=0;
  for(const [id,quantity] of cart){
    const product=products[id];count+=quantity;let row=area.querySelector(`[data-cart-id="${id}"]`);
    if(!row){
      row=document.createElement("div");row.dataset.cartId=id;row.className="glass rounded-2xl p-4";
      const top=document.createElement("div");top.className="flex items-start justify-between gap-3";
      const title=document.createElement("strong");title.textContent=product.name;
      const price=document.createElement("span");price.className="row-price shrink-0 text-[#83eaff]";
      top.append(title,price);
      const controls=document.createElement("div");controls.className="mt-3 flex items-center gap-3";
      const minus=document.createElement("button");minus.type="button";minus.className="secondary-btn rounded-lg px-3 py-1";minus.textContent="−";minus.setAttribute("aria-label",`Reducir cantidad de ${product.name}`);minus.onclick=()=>{const current=cart.get(id);current<=1?cart.delete(id):cart.set(id,current-1);renderCart()};
      const amount=document.createElement("span");amount.className="row-quantity";amount.setAttribute("aria-live","polite");
      const plus=document.createElement("button");plus.type="button";plus.className="secondary-btn rounded-lg px-3 py-1";plus.textContent="+";plus.setAttribute("aria-label",`Aumentar cantidad de ${product.name}`);plus.onclick=()=>{cart.set(id,cart.get(id)+1);renderCart()};
      const remove=document.createElement("button");remove.type="button";remove.className="ml-auto text-sm text-[#ffacd9] underline";remove.textContent="Quitar";remove.setAttribute("aria-label",`Quitar ${product.name}`);remove.onclick=()=>{cart.delete(id);renderCart()};
      controls.append(minus,amount,plus,remove);row.append(top,controls);area.append(row);
    }
    row.querySelector(".row-price").textContent=money(product.price*quantity);
    row.querySelector(".row-quantity").textContent=String(quantity);
  }
  area.querySelectorAll("[data-cart-id]").forEach(row=>{if(!cart.has(row.dataset.cartId))row.remove()});
  $("#cart-count").textContent=String(count);$("#cart-empty").hidden=count!==0;$("#subtotal").textContent=money(subtotal());$("#start-checkout").disabled=count===0;
  if(!$("#checkout-view").hidden)renderCheckout();
}
function addProduct(id){cart.set(id,(cart.get(id)||0)+1);renderCart();notice(`${products[id].name} añadido al carrito`)}
function openCart(){previousFocus=document.activeElement;$("#drawer-backdrop").hidden=false;$("#cart-drawer").hidden=false;$("#close-cart").focus()}
function closeCart(){$("#drawer-backdrop").hidden=true;$("#cart-drawer").hidden=true;previousFocus?.focus()}
function closeDetail(){$("#detail-overlay").hidden=true;previousFocus?.focus()}
function showDetail(id){
  selectedProduct=id;previousFocus=document.activeElement;
  const product=products[id];
  $("#detail-title").textContent=product.name;$("#detail-category").textContent=product.category;$("#detail-description").textContent=product.description;$("#detail-price").textContent=money(product.price);
  document.querySelectorAll("#detail-image-stage img").forEach(image=>image.classList.toggle("hidden",image.dataset.templateId!==`detail-${id}-image`));
  $("#detail-overlay").hidden=false;$("#close-detail").focus();
}
function shipping(){
  const method=$("#shipping-method").value;
  if(method==="other")return {label:"Otras zonas",rate:null,days:$("#days-other").value.trim()||"Por confirmar"};
  const local=method==="local",input=$(local?"#rate-local":"#rate-national"),value=Number(input.value);
  return {label:local?"Local":"Nacional",rate:input.value.trim()!==""&&Number.isFinite(value)&&value>=0&&value<=100000?value:null,days:$(local?"#days-local":"#days-national").value.trim()||"Por confirmar"};
}
function renderCheckout(){
  const estimate=shipping(),base=subtotal();
  $("#shipping-estimate").textContent=`${estimate.label} · ${estimate.rate===null?"Tarifa por confirmar":money(estimate.rate)} · ${estimate.days} (estimación)`;
  $("#order-items-summary").textContent=[...cart].map(([id,quantity])=>`${products[id].name} × ${quantity} — ${money(products[id].price*quantity)}`).join("\n");
  $("#review-subtotal").textContent=money(base);$("#review-shipping").textContent=estimate.rate===null?"Por confirmar":money(estimate.rate);
  $("#review-total").textContent=estimate.rate===null?`${money(base)} + envío por confirmar`:money(base+estimate.rate);
  $("#review-reference").textContent=`Referencia demo: ${$("#reypass-reference").value.trim()||"Sin referencia"}`;
}
function bookingFeedback(message,error=false){const element=$("#booking-feedback");element.textContent=message;element.className=`mt-4 text-sm ${error?"text-[#ffacd9]":"text-[#85eddb]"}`}
function todayMexico(){return new Intl.DateTimeFormat("en-CA",{timeZone:"America/Mazatlan",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date())}
async function initializeSdk(){
  if(!window.dataSdk){bookingFeedback("No se pudo conectar con la Canva Sheet. Intenta de nuevo más tarde.",true);return}
  try{
    const result=await window.dataSdk.init({onDataChanged(){/* Las solicitudes privadas no se muestran. */}});
    sdkReady=result.isOk;
    if(!sdkReady)bookingFeedback("No se pudo preparar el agendamiento. Reintenta al confirmar.",true);
  }catch{sdkReady=false;bookingFeedback("No se pudo preparar el agendamiento. Reintenta al confirmar.",true)}
}
document.querySelectorAll("[data-category]").forEach(button=>button.addEventListener("click",()=>{$("#category-filter").value=button.dataset.category;$("#search-input").value="";filterProducts();$("#catalogo").scrollIntoView({behavior:"smooth"})}));
$("#header-search").addEventListener("submit",event=>{event.preventDefault();filterProducts();$("#catalogo").scrollIntoView({behavior:"smooth"})});
$("#search-input").addEventListener("input",filterProducts);
["#category-filter","#price-filter","#sort-filter"].forEach(selector=>$(selector).addEventListener("input",filterProducts));
$("#product-grid").addEventListener("click",event=>{const card=event.target.closest("[data-product]");if(!card)return;if(event.target.closest(".detail-btn"))showDetail(card.dataset.product);else if(event.target.closest(".add-btn"))addProduct(card.dataset.product)});
$("#show-featured").onclick=()=>{$("#search-input").value="";$("#category-filter").value="all";$("#price-filter").value="15000";$("#sort-filter").value="featured";filterProducts();$("#catalogo").scrollIntoView({behavior:"smooth"});notice("Los destacados llevan una etiqueta en el catálogo")};
$("#open-cart").onclick=openCart;$("#close-cart").onclick=closeCart;$("#drawer-backdrop").onclick=closeCart;$("#close-detail").onclick=closeDetail;
$("#detail-overlay").addEventListener("click",event=>{if(event.target===event.currentTarget)closeDetail()});
$("#detail-add").onclick=()=>{if(selectedProduct){const id=selectedProduct;closeDetail();addProduct(id);openCart()}};
$("#start-checkout").onclick=()=>{if(!cart.size)return;$("#cart-view").hidden=true;$("#cart-footer").hidden=true;$("#checkout-success").hidden=true;$("#checkout-view").hidden=false;renderCheckout();$("#shipping-method").focus()};
$("#back-to-cart").onclick=()=>{$("#checkout-view").hidden=true;$("#cart-view").hidden=false;$("#cart-footer").hidden=false;$("#start-checkout").focus()};
["#shipping-method","#rate-local","#rate-national","#days-local","#days-national","#days-other","#reypass-reference"].forEach(selector=>$(selector).addEventListener("input",renderCheckout));
$("#confirm-demo").onclick=()=>{if(!cart.size)return;$("#checkout-error").textContent="";cart.clear();renderCart();$("#checkout-view").hidden=true;$("#checkout-success").hidden=false;$("#success-close").focus()};
$("#success-close").onclick=()=>{$("#checkout-success").hidden=true;$("#cart-view").hidden=false;$("#cart-footer").hidden=false;closeCart()};
$("#booking-date").min=todayMexico();
$("#booking-form").addEventListener("submit",event=>{
  event.preventDefault();if(!event.currentTarget.reportValidity())return;
  if($("#booking-date").value<todayMexico()){bookingFeedback("Selecciona una fecha futura o de hoy.",true);$("#booking-date").focus();return}
  bookingDraft={type:"service_request",service:$("#service").value,date:$("#booking-date").value,time:$("#booking-time").value,name:$("#customer-name").value.trim(),email:$("#customer-email").value.trim(),phone:$("#customer-phone").value.trim(),shipping_method:"",total:"",items:"",status:"pendiente_de_confirmacion",created_at:""};
  $("#booking-summary").textContent=`Servicio: ${bookingDraft.service}\nFecha: ${bookingDraft.date}\nHorario: ${bookingDraft.time}\nCliente: ${bookingDraft.name}\nCorreo: ${bookingDraft.email}\nTeléfono: ${bookingDraft.phone}`;
  $("#booking-review").hidden=false;bookingFeedback("Revisa los datos y confirma para enviar tu solicitud.");$("#confirm-booking").focus();
});
$("#booking-form").addEventListener("input",()=>{if(bookingDraft){bookingDraft=null;$("#booking-review").hidden=true;bookingFeedback("Datos modificados. Revisa nuevamente la solicitud.")}});
$("#confirm-booking").addEventListener("click",async event=>{
  const button=event.currentTarget;if(!bookingDraft)return;button.disabled=true;button.setAttribute("aria-busy","true");
  try{
    if(!sdkReady){await initializeSdk();if(!sdkReady)return}
    const result=await window.dataSdk.create({...bookingDraft,created_at:new Date().toISOString()});
    if(!result.isOk){bookingFeedback("No pudimos confirmar que se guardó la solicitud. Verifica con REYPLACE.MX antes de volver a enviarla.",true);return}
    bookingDraft=null;$("#booking-review").hidden=true;$("#booking-form").reset();$("#booking-date").min=todayMexico();bookingFeedback("Solicitud guardada. REYPLACE.MX deberá contactarte para confirmar disponibilidad; aún no es una cita confirmada.");
  }catch{bookingFeedback("No pudimos confirmar que se guardó la solicitud. Verifica con REYPLACE.MX antes de volver a enviarla.",true)}
  finally{button.disabled=false;button.removeAttribute("aria-busy")}
});
document.addEventListener("keydown",event=>{
  if(event.key==="Escape"){if(!$("#detail-overlay").hidden)closeDetail();else if(!$("#cart-drawer").hidden)closeCart()}
  if(event.key!=="Tab")return;
  const modal=!$("#detail-overlay").hidden?$("#detail-overlay"):!$("#cart-drawer").hidden?$("#cart-drawer"):null;
  if(!modal)return;
  const focusable=[...modal.querySelectorAll("button:not([disabled]),input:not([disabled]),select:not([disabled]),a[href],summary")].filter(element=>element.getClientRects().length);
  if(!focusable.length)return;
  if(event.shiftKey&&document.activeElement===focusable[0]){event.preventDefault();focusable.at(-1).focus()}
  else if(!event.shiftKey&&document.activeElement===focusable.at(-1)){event.preventDefault();focusable[0].focus()}
});
filterProducts();renderCart();initializeSdk();if(window.lucide)lucide.createIcons();
</script>
 
</body></html>