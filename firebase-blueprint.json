{
  "entities": {
    "Cart": {
      "title": "Cart",
      "description": "User shopping cart",
      "type": "object",
      "properties": {
        "items": {
          "type": "object",
          "description": "Map of product ID to quantity"
        }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Product in catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["name", "price", "stock", "category"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Superadmin user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review with ratings, multimedia, and moderation",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "city": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "pros": { "type": "string" },
        "cons": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "verifiedPurchase": { "type": "boolean" },
        "helpfulCount": { "type": "number" },
        "status": { "type": "string" },
        "officialResponse": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    },
    "SavedConfig": {
      "title": "SavedConfig",
      "description": "Saved smart home configurator room layout",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "propertyType": { "type": "string" },
        "room": { "type": "string" },
        "shareCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "propertyType", "room"]
    },
    "LoyaltyProfile": {
      "title": "LoyaltyProfile",
      "description": "VIP Loyalty Member Profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tier": { "type": "string" },
        "points": { "type": "number" },
        "totalSpentMxn": { "type": "number" }
      },
      "required": ["userId", "tier", "points"]
    }
  },
  "firestore": {
    "/users/{userId}/cart/default": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "User cart"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile"
    },
    "/users/{userId}/configurations/{configId}": {
      "schema": { "$ref": "#/entities/SavedConfig" },
      "description": "User saved room designs"
    },
    "/users/{userId}/loyalty/profile": {
      "schema": { "$ref": "#/entities/LoyaltyProfile" },
      "description": "User VIP loyalty status and points"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews and ratings"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized admins"
    }
  }
}
