{
  "entities": {
    "Cart": {
      "title": "Cart",
      "description": "User shopping cart",
      "type": "object",
      "properties": {
        "items": {
          "type": "object",
          "description": "Map of product ID to quantity"
        }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Product in catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["name", "price", "stock", "category"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Superadmin user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}/cart/default": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "User cart"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized admins"
    }
  }
}
