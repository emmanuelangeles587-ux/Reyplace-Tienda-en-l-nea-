rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
                     && incoming().displayName == existing().displayName // Assuming displayName is immutable or controlled differently? Actually no, let's allow it.
                     && incoming().email == existing().email; // Immutable fields

      function isValidUserProfile(data) {
        return data.displayName is string && data.displayName.size() <= 100 
            && data.email is string && data.email.size() <= 255;
      }

      match /cart/default {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidCart(incoming());
        
        function isValidCart(data) {
          return data.items is map;
        }
      }
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Admins
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable from backend or console
    }
  }
}
